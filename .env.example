GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_TOKENS=2048
GEMINI_TIMEOUT_SECONDS=105
GEMINI_MAX_IMAGE_EDGE=1568
REQUIRE_HTTPS=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_FILE_SIZE_MB=15
DETECTION_ENABLED=true
VALIDATION_ENABLED=true
DETECTION_OUTPUT_DIR=detections
DETECTION_PDF_DPI=200
DETECTION_CROP_PADDING_PX=10
DETECTION_CROP_PADDING_RATIO=0.015
DETECTION_CROP_TOP_PADDING_RATIO=0.015
DETECTION_ROTATION_MIN_CONFIDENCE=0.7
DETECTION_CROP_TARGET_LONG_EDGE=1600
DETECTION_CROP_SHARPEN_AMOUNT=0.6
DETECTION_CROP_CONTRAST_CLIP=1.5
DOCUMENT_RETENTION_SECONDS=0
EXTRACTED_DATA_RETENTION_SECONDS=0
API_RESPONSE_RETENTION_SECONDS=0
LOG_RETENTION_DAYS=30
# Output folder for the /ocr/leasing endpoints
LEASING_OUTPUT_DIR=postman_output
